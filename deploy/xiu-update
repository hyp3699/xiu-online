#!/bin/bash
# 手动更新 xiu-online 测试服；不会访问或修改原版 xiu 仓库和服务。
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
DIR=/opt/xiu-online
SERVICE=xiu-online-test
PUBLIC_IP="$(curl -4fsS --max-time 8 https://api.ipify.org || true)"
if [[ ! "$PUBLIC_IP" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  echo "无法自动探测服务器公网 IPv4；请检查服务器的出网连接后重试。" >&2
  exit 1
fi
REPO="${XIU_REPO:-https://gitlab.com/hepicpde-group/xiu.git}"
printf '>>> 从 %s 拉取 main 分支（强制覆盖服务器上的代码）\n' "$REPO"
# 远程地址统一指向 GitLab（旧服务器的 origin 还是 GitHub，这里自动改过来）
git -C "$DIR" remote set-url origin "$REPO" 2>/dev/null || git -C "$DIR" remote add origin "$REPO"
git -C "$DIR" fetch --depth 1 --force origin main
# 强制覆盖：丢弃服务器上对代码的任何改动，并删掉仓库里没有的文件（保留 server/node_modules；存档在 /var/lib/xiu-online 不受影响）
git -C "$DIR" reset --hard FETCH_HEAD
git -C "$DIR" clean -fdx -e server/node_modules
# 更新器自己有新版本时，装好后用新版本重新执行一遍（否则本次仍按旧脚本跑，新增步骤要等下次才生效）
if [ -z "${XIU_UPDATE_REEXEC:-}" ] && ! cmp -s "$DIR/deploy/xiu-update" /usr/local/bin/xiu-online-update; then
  install -m 0755 "$DIR/deploy/xiu-update" /usr/local/bin/xiu-online-update
  XIU_UPDATE_REEXEC=1 exec /usr/local/bin/xiu-online-update "$@"
fi
install -m 0755 "$DIR/deploy/xiu-update" /usr/local/bin/xiu-online-update
install -m 0755 "$DIR/deploy/uninstall.sh" /usr/local/bin/xiu-online-uninstall
# 快捷命令 x：域名管理（选已有证书绑定域名）。/usr/local/bin/x 已被别的程序占用就不覆盖，用 xiu-online-domain
install -m 0755 "$DIR/deploy/xiu-domain.sh" /usr/local/bin/xiu-online-domain
if [ ! -e /usr/local/bin/x ] || grep -q XIU-ONLINE-DOMAIN-TOOL /usr/local/bin/x 2>/dev/null; then install -m 0755 "$DIR/deploy/xiu-domain.sh" /usr/local/bin/x
else echo ">>> /usr/local/bin/x 已被其它程序占用，域名管理请用：xiu-online-domain"; fi
# 旧版的 GitHub 备份脚本已改为游戏内「管理员 → 服务器信息」设置：清理掉
systemctl disable --now xiu-online-backup-github.timer >/dev/null 2>&1 || true
rm -f /usr/local/bin/xiu-online-backup-github /usr/local/bin/xiu-online-backup-setup /etc/systemd/system/xiu-online-backup-github.service /etc/systemd/system/xiu-online-backup-github.timer
(cd "$DIR/server" && npm ci --omit=dev --no-audit --no-fund)
# 给静态脚本生成内容哈希版本，避免测试服客户端继续使用旧缓存。
python3 - "$DIR/web" <<'PY'
import hashlib, pathlib, re, sys
web = pathlib.Path(sys.argv[1]); index = web / "index.html"
text = index.read_text(encoding="utf-8")
def update(match):
    prefix, rel = match.group(1), match.group(2)
    file = web / rel
    version = hashlib.sha256(file.read_bytes()).hexdigest()[:10] if file.is_file() else "0"
    return f'{prefix}?v={version}"'
text = re.sub(r'((?:src|href)="([^"?:]+))\?v=[^"]*"', update, text)
index.write_text(text, encoding="utf-8")
PY
# 安卓图片热更新清单：MainActivity 靠服务器上的 web/img_ver.txt 比对图片，
# 以前这里没生成（只有打包 APK 时生成内置清单），安卓端永远用内置旧图。
# 格式与 .github/workflows/apk.yml 一致：首行是 web/img 的树哈希前 8 位，
# 之后每行是「相对路径 空格 文件哈希前 8 位」。clean -fdx 会删掉旧清单，
# 所以必须在 clean 之后、nginx reload 之前重新生成。
git -C "$DIR" rev-parse HEAD:web/img | cut -c1-8 > "$DIR/web/img_ver.txt"
git -C "$DIR" ls-files -s web/img | awk -F'\t' '{split($1,a," "); print substr($2,9)" "substr(a[2],1,8)}' >> "$DIR/web/img_ver.txt"
install -m 0644 "$DIR/deploy/xiu-server.service" "/etc/systemd/system/${SERVICE}.service"
install -m 0644 "$DIR/deploy/xiu-web-update.service" /etc/systemd/system/xiu-online-web-update.service
install -m 0644 "$DIR/deploy/xiu-web-update.path" /etc/systemd/system/xiu-online-web-update.path
systemctl daemon-reload
systemctl enable --now xiu-online-web-update.path >/dev/null 2>&1 || true
systemctl restart "$SERVICE"
systemctl is-active --quiet "$SERVICE"
for _ in $(seq 1 20); do curl -fsS http://127.0.0.1:18301/health >/dev/null && break || sleep 1; done
curl -fsS http://127.0.0.1:18301/health
for D in /etc/nginx/conf.d/central_vps_users/*/ /etc/nginx/snippets/; do
  [ -f "${D}xiu-online-test.conf" ] && install -m 0644 "$DIR/deploy/nginx-xiuxian.conf" "${D}xiu-online-test.conf"
done
IP_NGX_TMP=$(mktemp)
sed "s/__XIU_PUBLIC_IP__/${PUBLIC_IP}/g" "$DIR/deploy/nginx-xiuxian-ip.conf" > "$IP_NGX_TMP"
install -m 0644 "$IP_NGX_TMP" /etc/nginx/conf.d/xiu-online-ip-test.conf
rm -f "$IP_NGX_TMP"
nginx -t
systemctl reload nginx
printf '\n更新完成。测试入口：http://%s/（HTTP，仅供临时测试）\nCloudflare Tunnel origin：http://127.0.0.1:18302（HTTP）\n' "$PUBLIC_IP"
